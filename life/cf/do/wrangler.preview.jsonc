{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "junja-world-unified-preview",
  "main": "./worker-unified.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VILLAGE_ROOMS",
        "class_name": "VillageRoom"
      },
      {
        "name": "VILLAGE_DB",
        "class_name": "VillageDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VillageRoom",
        "VillageDatabase"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
