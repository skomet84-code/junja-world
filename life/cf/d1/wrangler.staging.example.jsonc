{
  // STAGING TEMPLATE ONLY — never replace the live junja-world Worker.
  // Copy to wrangler.staging.jsonc after provisioning an EMPTY D1 database.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "junja-world-d1-staging",
  "main": "./worker-staging.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "junja-world-d1-staging",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_UUID",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VILLAGE_ROOMS", "class_name": "VillageRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VillageRoom"] }]
}
