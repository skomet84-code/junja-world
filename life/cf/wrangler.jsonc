{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "junja-village-v50-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VILLAGE_ROOMS", "class_name": "VillageRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VillageRoom"] }
  ]
}
