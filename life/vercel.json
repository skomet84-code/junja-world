{
  "version": 2,
  "builds": [
    {
      "src": "api/account.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ws.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "hunt.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "vendor/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/account",
      "dest": "/api/account.js"
    },
    {
      "src": "/api/ws",
      "dest": "/api/ws.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
