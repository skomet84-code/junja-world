{
  "version": 2,
  "builds": [
    {
      "src": "api/share-image.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/account.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/economy-v36.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/economy-v37.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ws.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "hunt.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "vendor/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.js)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/share-image",
      "dest": "/api/share-image.js"
    },
    {
      "src": "/api/account",
      "dest": "/api/account.js"
    },
    {
      "src": "/api/economy-v36",
      "dest": "/api/economy-v36.js"
    },
    {
      "src": "/api/economy-v37",
      "dest": "/api/economy-v37.js"
    },
    {
      "src": "/api/ws",
      "dest": "/api/ws.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
